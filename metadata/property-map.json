{
  "repo": "onyx-parse-markdown-scope",
  "language": "Ruby",
  "category": "Parsers",
  "goal": "Implement a Ruby parsers project for markdown resource planning, using capacity fixtures and allocation and spill reports.",
  "weights": {
    "signal": 2,
    "slack": 1,
    "confidence": 1,
    "drag": 3
  },
  "thresholds": {
    "ship": 181,
    "watch": 111
  },
  "properties": [
    "raising signal cannot reduce score",
    "raising drag cannot improve score",
    "lane labels must match configured thresholds",
    "golden fixture ids must remain unique"
  ],
  "fixture_files": [
    "fixtures/golden/scoreboard.csv",
    "fixtures/golden/lane-matrix.csv",
    "fixtures/fuzz/mutations.csv",
    "fixtures/fuzz/boundary-cases.jsonl"
  ]
}
